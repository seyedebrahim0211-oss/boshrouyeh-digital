{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "milk",
					"color": "#F6EEE1",
					"name": "شیری خاک"
				},
				{
					"slug": "kahgel",
					"color": "#E2C9A3",
					"name": "کاهگل"
				},
				{
					"slug": "khesht",
					"color": "#A0673F",
					"name": "خشت"
				},
				{
					"slug": "brick",
					"color": "#6E3B23",
					"name": "آجری تیره"
				},
				{
					"slug": "qanat",
					"color": "#16737A",
					"name": "فیروزهٔ قنات"
				},
				{
					"slug": "night",
					"color": "#1F2A44",
					"name": "لاجورد شب کویر"
				},
				{
					"slug": "sun",
					"color": "#D9A441",
					"name": "زرد خورشید"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "سفید"
				},
				{
					"slug": "ink",
					"color": "#2A211C",
					"name": "متن"
				}
			],
			"gradients": [
				{
					"slug": "dusk",
					"gradient": "linear-gradient(180deg,#F6EEE1 0%,#E2C9A3 100%)",
					"name": "غروب کویر"
				},
				{
					"slug": "night-sky",
					"gradient": "linear-gradient(180deg,#1F2A44 0%,#2B3A5C 100%)",
					"name": "آسمان شب"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"size": "0.5rem",
					"name": "۸"
				},
				{
					"slug": "20",
					"size": "1rem",
					"name": "۱۶"
				},
				{
					"slug": "30",
					"size": "1.5rem",
					"name": "۲۴"
				},
				{
					"slug": "40",
					"size": "clamp(1.75rem, 3vw, 2.5rem)",
					"name": "۴۰"
				},
				{
					"slug": "50",
					"size": "clamp(2.25rem, 5vw, 4rem)",
					"name": "۶۴"
				},
				{
					"slug": "60",
					"size": "clamp(3rem, 8vw, 6rem)",
					"name": "۹۶"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "کوچک",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "متن",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.125rem",
					"name": "تیتر ۳",
					"fluid": {
						"min": "1.05rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "x-large",
					"size": "1.875rem",
					"name": "تیتر ۲",
					"fluid": {
						"min": "1.4rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "3rem",
					"name": "تیتر ۱",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "body",
					"name": "وزیرمتن",
					"fontFamily": "Vazirmatn, Tahoma, sans-serif",
					"fontFace": [
