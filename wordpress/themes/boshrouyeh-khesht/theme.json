		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"shadow": "0 6px 24px rgba(110,59,35,.08)",
					"name": "نرم"
				},
				{
					"slug": "lift",
					"shadow": "0 14px 40px rgba(31,42,68,.14)",
					"name": "برجسته"
				}
			]
		},
		"custom": {
			"radius": {
				"card": "14px",
				"button": "10px",
				"taqche": "999px 999px 12px 12px"
			},
			"line": "1.75"
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--milk)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.85"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--qanat)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--brick)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--sun)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--brick)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.35"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--large)"
				},
				"color": {
					"text": "var(--wp--preset--color--night)"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "1rem"
				},
				"color": {
					"text": "var(--wp--preset--color--night)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--qanat)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "10px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "0.95rem"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"bottom": "0.7rem",
						"left": "1.4rem",
						"right": "1.4rem"
					}
				},
				":hover": {
					"color": {
						"background": "#115E64"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--sun)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "0.85rem"
				},
				"color": {
					"text": "#6b5a4e"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--quote)",
					"fontSize": "1.35rem"
				},
				"color": {
					"text": "var(--wp--preset--color--qanat)"
				},
				"border": {
					"right": {
						"color": "var(--wp--preset--color--sun)",
						"width": "4px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"right": "1.25rem"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--kahgel)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.4rem"
				}
			},
			"core/search": {
				"border": {
					"radius": "10px"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "0.95rem"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "topbar",
			"title": "نوار بالایی",
			"area": "header"
		},
		{
			"name": "header",
			"title": "سربرگ",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "پانویس",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-khesht-builder",
			"title": "صفحه‌ساز خشت (تمام‌عرض)",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "page-no-title",
			"title": "برگه بدون عنوان",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-citizen",
			"title": "پیشخوان شهروند",
			"postTypes": [
				"page"
			]
		}
	]
}